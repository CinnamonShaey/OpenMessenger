{
  "name": "openmessenger",
  "productName": "OpenMessenger",
  "version": "0.4.0",
  "description": "A portable desktop app for Facebook Messenger with custom themes and notification sounds.",
  "main": "src/main.js",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "CinnamonShaey",
  "repository": "github:CinnamonShaey/OpenMessenger",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --remote-debugging-port=9333",
    "dist": "electron-builder --publish never",
    "assets": "uv run --with pillow python scripts/make-assets.py"
  },
  "build": {
    "appId": "io.github.cinnamonshaey.openmessenger",
    "publish": [
      {
        "provider": "github",
        "owner": "CinnamonShaey",
        "repo": "OpenMessenger"
      }
    ],
    "productName": "OpenMessenger",
    "files": [
      "src/**",
      "themes/**",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "assets/**"
    ],
    "directories": {
      "output": "dist"
    },
    "electronFuses": {
      "enableCookieEncryption": true,
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "OpenMessenger-${version}-win-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenMessenger",
      "uninstallDisplayName": "OpenMessenger",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "OpenMessenger-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.social-networking",
      "target": [
        "zip"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Network;InstantMessaging",
      "target": [
        "AppImage",
        "tar.gz"
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
